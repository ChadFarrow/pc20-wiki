<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Publishes vault edits to the wiki.

  WatchPaths is the fast path: kqueue fires when the notes directory changes,
  which covers saves, adds, renames and files iCloud brings down from another
  device. StartInterval is the backstop, because an in-place write to an
  existing file does not always disturb the directory. A run with nothing to do
  exits in well under a second.

  Install:
    cp launchd/com.chadfarrow.pc20-wiki-sync.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.chadfarrow.pc20-wiki-sync.plist

  Stop:
    launchctl unload ~/Library/LaunchAgents/com.chadfarrow.pc20-wiki-sync.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chadfarrow.pc20-wiki-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/chad-mini/Vibe/pc20-wiki/scripts/auto-publish.sh</string>
    </array>

    <key>WatchPaths</key>
    <array>
        <string>/Users/chad-mini/Library/Mobile Documents/iCloud~md~obsidian/Documents/PC 2.0 hivemind/notes</string>
        <string>/Users/chad-mini/Library/Mobile Documents/iCloud~md~obsidian/Documents/PC 2.0 hivemind/Home.md</string>
    </array>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>StandardOutPath</key>
    <string>/Users/chad-mini/Library/Logs/pc20-wiki-sync.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/chad-mini/Library/Logs/pc20-wiki-sync.err</string>
</dict>
</plist>
