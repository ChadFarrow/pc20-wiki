<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Brings new episodes into the wiki's inputs: the episode list in pc20-timeline
  and the caption cache. Generated by scripts/install-agent.sh — edit this
  template, not the copy in ~/Library/LaunchAgents.

  Every 6 hours. The show is weekly, and each run retries the caption stubs on
  the show's server, so more often would only ask it the same eight questions.
  It never publishes: com.chadfarrow.pc20-wiki-sync picks the new inputs up on
  its next pass, within 15 minutes.

  Install:  ./scripts/install-agent.sh
  Stop:     launchctl unload ~/Library/LaunchAgents/com.chadfarrow.pc20-wiki-episodes.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chadfarrow.pc20-wiki-episodes</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/scripts/refresh-episodes.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>21600</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/pc20-wiki-episodes.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/pc20-wiki-episodes.err</string>
</dict>
</plist>
