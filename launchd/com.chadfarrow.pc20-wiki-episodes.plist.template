<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Brings new episodes into the wiki's inputs: the episode list in pc20-timeline
  and the caption cache. Generated by scripts/install-agent.sh — edit this
  template, not the copy in ~/Library/LaunchAgents.

  Fridays at 22:00 local time. The show is weekly and comes out on Friday: from
  May to September 2026 every episode landed between 19:11 and 21:04 UTC, and its
  captions within 30 minutes, so 22:00 in New York leaves about five hours. An
  episode that is late, or captions still "processing", wait a week — or run
  `npm run episodes`. launchd runs a missed slot on wake if the Mac was asleep,
  but not if it was off. It never publishes: com.chadfarrow.pc20-wiki-sync picks
  the new inputs up on its next pass, within 15 minutes.

  Install:  ./scripts/install-agent.sh
  Stop:     launchctl unload ~/Library/LaunchAgents/com.chadfarrow.pc20-wiki-episodes.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chadfarrow.pc20-wiki-episodes</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/scripts/refresh-episodes.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>5</integer>
        <key>Hour</key>
        <integer>22</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/pc20-wiki-episodes.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/pc20-wiki-episodes.err</string>
</dict>
</plist>
