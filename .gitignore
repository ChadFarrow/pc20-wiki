node_modules/
.DS_Store
.env
.env.local
.vercel

# Build output — regenerated by `npm run build`.
# public/assets/ is hand-written source and stays committed.
public/index.html
public/notes/
public/data/
public/graph/
public/queue/
public/timeline/

# content/ is a synced copy of the Obsidian vault and IS committed:
# Vercel has no access to iCloud, so the build reads only what is in the repo.

# Caption cache — ~41 MB, filled by scripts/fetch-captions.mjs, never committed.
# What gets committed is the derived data/mentions.json, same as everything else.
captions/

# Screenshots from `npm run check:browser -- --shots`
shots/

# Generated by scripts/install-agent.sh — it names absolute paths
launchd/*.plist

# Isolated workspaces for in-flight work — see superpowers:using-git-worktrees.
.worktrees/
